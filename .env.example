# App
NEXT_PUBLIC_APP_NAME="Ecomerce Futbol"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature flags
NEXT_PUBLIC_USE_MOCK_DATA="true"
# Keep disabled until sandbox credentials are configured locally.
PAYMENTS_ENABLED="false"
PAYMENT_METHOD_IDS="visa,master"

# Database
DATABASE_URL="postgresql://ecomerce_futbol:ecomerce_futbol_password@localhost:5432/ecomerce_futbol?schema=public"
# PostgreSQL integration tests run only when this points to a dedicated test
# database or schema. It must not resolve to the DATABASE_URL/Supabase project.
TEST_DATABASE_URL=""

# Mercado Pago
# Public key: safe to expose to the browser.
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=""
# Server-only secrets: do not expose or commit these values.
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# Temporary internal admin boundary. Set only through the deployment secret manager;
# never use a NEXT_PUBLIC_ prefix, commit a real value, or place it in client configuration.
POST_PAYMENT_ADMIN_TOKEN=""

# Dedicated server-to-server secret for the payment reconciliation scheduler.
# It is intentionally separate from POST_PAYMENT_ADMIN_TOKEN.
RECONCILIATION_CRON_SECRET=""

# Supabase Auth server boundary. APP_ORIGIN is the server-only exact origin
# override for local development and Netlify Production; it has no path,
# wildcard, query, fragment, or credentials. Netlify Deploy Previews omit it
# and use the trusted system-provided DEPLOY_PRIME_URL automatically.
# Admin authorization is stored in the application's AdminMembership table.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server-only Storage credentials. Never expose the service-role key to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PRODUCT_IMAGES_BUCKET="product-images"
APP_ORIGIN=""
