generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CurrencyCode {
  ARS
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String
  imageUrl    String?
  parentId    String?  @db.Uuid
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@index([isActive])
}

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive])
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  slug           String        @unique
  description    String
  categoryId     String        @db.Uuid
  brandId        String        @db.Uuid
  price          Int
  compareAtPrice Int?
  currency       CurrencyCode  @default(ARS)
  featured       Boolean       @default(false)
  status         ProductStatus @default(DRAFT)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  images   ProductImage[]

  @@index([categoryId, status, isActive])
  @@index([brandId, status, isActive])
  @@index([featured, status, isActive])
  @@index([price])
}

model ProductVariant {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  name      String
  size      String?
  color     String?
  surface   String?
  price     Int?
  sku       String?  @unique
  stock     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images  ProductImage[]
  reservations StockReservation[]
  @@index([productId, isActive])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  variantId String?  @db.Uuid
  url       String
  alt       String
  position  Int
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([productId, position])
  @@index([variantId])
}

enum OrderStatus {
  PENDING_CONFIRMATION
  PAYMENT_PENDING
  PAID
  PAYMENT_FAILED
  CANCELLED
  REFUNDED
}

enum PostPaymentOperationType {
  CANCEL
  REFUND
}

enum PostPaymentOperationStatus {
  RUNNING
  COMPLETED
}

enum PaymentAttemptStatus {
  CREATED
  DISPATCHING
  PENDING
  PAID
  FAILED
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

enum WebhookReceiptState {
  RECEIVED
  PROCESSING
  PROCESSED
  RETRYABLE_FAILED
}

model Order {
  id                  String      @id @default(uuid()) @db.Uuid
  userId              String?     @db.Uuid
  contactEmail        String
  contactFullName     String
  contactPhone        String
  shippingAddress     Json
  currency            CurrencyCode @default(ARS)
  total               Int
  status              OrderStatus @default(PENDING_CONFIRMATION)
  statusCapabilityHash String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  lines               OrderLine[]
  attempts            PaymentAttempt[]
  reservations        StockReservation[]
  postPaymentOperations PostPaymentOperation[]
  @@index([status])
}

model PostPaymentOperation {
  id             String                    @id @default(uuid()) @db.Uuid
  orderId        String                    @db.Uuid
  type           PostPaymentOperationType
  status         PostPaymentOperationStatus @default(RUNNING)
  idempotencyKey String                    @unique
  providerOrderId String?
  providerStatus String?
  createdAt      DateTime                  @default(now())
  completedAt    DateTime?
  order          Order                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@unique([orderId, type])
  @@index([orderId, status])
}

model OrderLine {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  productId String   @db.Uuid
  variantId String?  @db.Uuid
  name      String
  quantity  Int
  unitPrice Int
  lineTotal Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model PaymentAttempt {
  id             String               @id @default(uuid()) @db.Uuid
  orderId        String               @db.Uuid
  intentId       String
  idempotencyKey String               @unique
  status         PaymentAttemptStatus @default(CREATED)
  payloadHash    String
  providerOrderId String? @unique
  providerPaymentId String?
  providerOrderStatus String?
  providerPaymentStatus String?
  providerStatusDetail String?
  providerUpdatedAt DateTime?
  reconcileCount Int @default(0)
  nextReconcileAt DateTime?
  reconcileLeaseUntil DateTime?
  reconcileLastError String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  order          Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, intentId])
  @@index([orderId, status])
  @@index([status, nextReconcileAt, id])
}

model StockReservation {
  id        String            @id @default(uuid()) @db.Uuid
  orderId   String            @db.Uuid
  variantId String            @db.Uuid
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@index([variantId, status])
}

model WebhookReceipt {
  id String @id @default(uuid()) @db.Uuid
  provider String
  applicationId String
  topic String
  notificationId String
  resourceId String
  action String?
  liveMode Boolean?
  providerCreatedAt DateTime?
  requestId String?
  signatureTimestamp String?
  signatureVersion String?
  rawBodySha256 String
  state WebhookReceiptState @default(RECEIVED)
  leaseUntil DateTime?
  attemptCount Int @default(0)
  lastAttemptAt DateTime?
  lastErrorCode String?
  receivedAt DateTime @default(now())
  processedAt DateTime?

  @@unique([provider, applicationId, topic, notificationId])
  @@index([state, leaseUntil])
}
